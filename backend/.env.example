OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=qwen2.5:0.5b
DEFAULT_RAG_MODEL=gemma3:12b
EMBEDDING_MODEL=nomic-embed-text
REQUEST_TIMEOUT_SECONDS=120

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

POSTGRES_DSN=postgresql+asyncpg://po_user:po_password@localhost:5432/po_assistant

RAW_DATA_DIR=../data/raw
DEFAULT_TENANT_ID=local_demo
DEFAULT_BUCKET_ID=taskflow_seed
RAG_TOP_K=5
# Default baseline for cleaner retrieval. Set empty/undefined only if you want to disable score filtering.
RAG_SCORE_THRESHOLD=0.68
EXCEL_SUPPLEMENT_SCROLL_LIMIT=1000
DOCX_SUPPLEMENT_SCROLL_LIMIT=1000
IMAGE_VISION_ENABLED=true
IMAGE_VISION_MODEL=gemma4:12b

# Conversation summary strategies: rule_based, llm, hybrid.
# hybrid tries LLM JSON summary first and falls back to rule_based if validation fails.
CONVERSATION_SUMMARY_STRATEGY=hybrid
CONVERSATION_SUMMARY_MODEL=gemma4:12b
CONVERSATION_SUMMARY_TEMPERATURE=0.0

# M4.5 prompt memory budget. Memory is conversation context, not product evidence.
CONVERSATION_MEMORY_ENABLED=true
CONVERSATION_MEMORY_TOKEN_BUDGET=350
CONVERSATION_MEMORY_RECENT_MESSAGES=4
