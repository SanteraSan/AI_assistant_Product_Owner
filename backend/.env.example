OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=qwen2.5:0.5b
DEFAULT_RAG_MODEL=gemma3:12b
EMBEDDING_MODEL=nomic-embed-text
REQUEST_TIMEOUT_SECONDS=120

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents

POSTGRES_DSN=postgresql+asyncpg://po_user:po_password@localhost:5432/po_assistant
# Local demo fallback. Set to false after running Alembic migrations.
DATABASE_AUTO_CREATE_TABLES=true

RAW_DATA_DIR=../data/raw
DEFAULT_TENANT_ID=local_demo
DEFAULT_BUCKET_ID=taskflow_seed
RAG_TOP_K=5
# Default baseline for cleaner retrieval. Set empty/undefined only if you want to disable score filtering.
RAG_SCORE_THRESHOLD=0.68
EXCEL_SUPPLEMENT_SCROLL_LIMIT=1000
DOCX_SUPPLEMENT_SCROLL_LIMIT=1000
IMAGE_VISION_ENABLED=true
IMAGE_VISION_MODEL=gemma4:12b

# Conversation summary strategies: rule_based, llm, hybrid.
# hybrid tries LLM JSON summary first and falls back to rule_based if validation fails.
CONVERSATION_SUMMARY_STRATEGY=hybrid
CONVERSATION_SUMMARY_MODEL=gemma4:12b
CONVERSATION_SUMMARY_TEMPERATURE=0.0

# M4.5 prompt memory budget. Memory is conversation context, not product evidence.
CONVERSATION_MEMORY_ENABLED=true
CONVERSATION_MEMORY_TOKEN_BUDGET=350
CONVERSATION_MEMORY_RECENT_MESSAGES=4

# Request/validation limits.
MAX_CHAT_MESSAGE_CHARS=8000
MAX_RAG_TOP_K=20
MAX_FILTER_VALUES=50
MAX_FILTER_VALUE_CHARS=512

# Redis-backed rate limiting and Ollama concurrency protection.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_FAIL_OPEN=true
OLLAMA_MAX_CONCURRENCY=2
OLLAMA_QUEUE_TIMEOUT_SECONDS=5

# JSON list consumed by pydantic-settings.
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# BFF→backend signed service JWT (must match bff/.env).
SERVICE_JWT_SECRET=taskflow-bff-service-jwt-dev-secret
SERVICE_JWT_ISSUER=taskflow-bff
SERVICE_JWT_AUDIENCE=taskflow-backend

# E5 Kafka/Redpanda indexing (default off = BackgroundTasks).
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_INDEXING_TOPIC=taskflow.indexing.requested
KAFKA_DOCUMENT_EVENTS_TOPIC=taskflow.document.events
KAFKA_CONSUMER_GROUP=taskflow-indexing-workers
QDRANT_CHECK_COMPATIBILITY=false
